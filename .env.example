# Copy to .env and fill in the model API settings.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=know_engine
PG_PASSWORD=know_engine
PG_DB=know_engine

# --- Elasticsearch ---
ES_VERSION=8.15.3
ES_URL=http://localhost:9200
ES_INDEX_ALIAS=know-engine-chunks

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=know-engine
MINIO_SECURE=false

# --- MinerU (PDF/DOCX -> Markdown service) ---
MINERU_URL=http://localhost:8000

# --- Model API (OpenAI compatible) ---
LLM_BASE_URL=
LLM_API_KEY=
CHAT_MODEL=qwen3.8:27b
LIGHT_MODEL=qwen3.5:9b
VISION_MODEL=qwen3-vl:32b
# "none" turns off thinking for chat calls (a one-line rewrite drops from ~50 s to ~2 s)
LLM_REASONING_EFFORT=none
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024

# --- Local reranker ---
RERANK_MODEL=BAAI/bge-reranker-base
